# NewsBot Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Perplexity Sonar API ---
# Get your key at: https://www.perplexity.ai/settings/api
PPLX_API_KEY=your_perplexity_api_key_here

# --- Email Delivery (Resend) ---
# Sign up at: https://resend.com — free tier is 3,000 emails/month
RESEND_API_KEY=your_resend_api_key_here
NEWSBOT_EMAIL_FROM=newsbot@yourdomain.com
NEWSBOT_EMAIL_TO=you@example.com
# Optional: comma-separated list for small recipient group
# NEWSBOT_EMAIL_TO=you@example.com,friend@example.com

# --- Telegram (optional, leave blank to disable) ---
NEWSBOT_TELEGRAM_TOKEN=
NEWSBOT_TELEGRAM_CHAT_ID=

# --- Local LLM (llama.cpp) ---
# Default assumes llama.cpp server running locally on port 8080
LLAMA_CPP_BASE_URL=http://localhost:8080
LLAMA_CPP_MODEL=llama3

# --- Brave Search API (optional, improves fallback summaries) ---
# Get your key at: https://api.search.brave.com/app/keys
# Free tier: 2,000 queries/month. NewsBot uses ~20-40 per run (only fires
# when RSS descriptions are empty or junk), so free tier is sufficient.
BRAVE_SEARCH_API_KEY=

# --- Optional: Anthropic (for higher-quality summarization) ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
